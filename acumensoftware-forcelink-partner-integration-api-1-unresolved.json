  "components" : {
    "schemas" : {
      "ApiEnvelopeBase" : {
        "type" : "object",
        "description" : "Shared response shell for every partner-integration endpoint. Mirrors the envelope used by the core Forcelink v1 API so downstream consumers only need to learn one shape.",
        "required" : [ "success", "meta" ],
        "properties" : {
          "success" : {
            "type" : "boolean"
          },
          "data" : {
            "nullable" : true,
            "description" : "Payload on success. Null on error."
          },
          "message" : {
            "type" : "string",
            "nullable" : true
          },
          "error" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/ApiError"
            } ]
          },
          "pagination" : {
            "$ref" : "#/components/schemas/Pagination"
          },
          "meta" : {
            "$ref" : "#/components/schemas/ResponseMeta"
          }
        }
      },
      "ApiError" : {
        "type" : "object",
        "required" : [ "code", "message" ],
        "properties" : {
          "code" : {
            "type" : "string",
            "enum" : [ "VALIDATION_ERROR", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "RATE_LIMITED", "INTERNAL_ERROR" ]
          },
          "message" : {
            "type" : "string"
          },
          "details" : {
            "type" : "array",
            "items" : {
              "type" : "object",
              "properties" : {
                "field" : {
                  "type" : "string"
                },
                "code" : {
                  "type" : "string"
                },
                "message" : {
                  "type" : "string"
                }
              }
            }
          }
        }
      },
      "ResponseMeta" : {
        "type" : "object",
        "required" : [ "request_id", "version", "timestamp" ],
        "properties" : {
          "request_id" : {
            "type" : "string",
            "pattern" : "^req_[0-9A-HJKMNP-TV-Z]{26}$",
            "example" : "req_01K5H8N2Q3ZC1WQ8R6M0T4X9YB"
          },
          "version" : {
            "type" : "string",
            "example" : "1"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "Pagination" : {
        "nullable" : true,
        "description" : "Present on every endpoint in this spec (all are list endpoints). Follows the same shape as the core Forcelink v1 API.",
        "type" : "object",
        "properties" : {
          "page" : {
            "type" : "integer",
            "example" : 1
          },
          "per_page" : {
            "type" : "integer",
            "example" : 50
          },
          "total_items" : {
            "type" : "integer",
            "example" : 137
          },
          "total_pages" : {
            "type" : "integer",
            "example" : 3
          }
        }
      },
      "ShiftAttendanceRecord" : {
        "type" : "object",
        "properties" : {
          "employeeId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Forcelink resource/employee id."
          },
          "employeeCode" : {
            "type" : "string",
            "description" : "Employee's payroll/staff code, if configured."
          },
          "orgUnit" : {
            "type" : "object",
            "description" : "The site the shift is planned against.",
            "properties" : {
              "id" : {
                "type" : "integer",
                "format" : "int64"
              },
              "type" : {
                "type" : "string",
                "enum" : [ "SITE" ]
              },
              "name" : {
                "type" : "string",
                "example" : "Depot - Bellville"
              }
            }
          },
          "shiftDate" : {
            "type" : "string",
            "format" : "date",
            "description" : "Calendar date the shift falls on (per-shift/day granularity, not a live feed)."
          },
          "clockInTimestamp" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true,
            "description" : "Null if the employee never clocked in for this shift."
          },
          "clockOutTimestamp" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ON_TIME", "LATE", "ABSENT", "ON_LEAVE" ],
            "description" : "Derived attendance flag for the shift."
          },
          "leaveStatus" : {
            "type" : "string",
            "enum" : [ "NONE", "PENDING", "APPROVED", "REJECTED" ],
            "description" : "`NONE` unless a leave request overlaps this date."
          }
        }
      },
      "CompletedWorkOrder" : {
        "type" : "object",
        "properties" : {
          "workOrderId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "workOrderCode" : {
            "type" : "string",
            "example" : "WO-2026-104822"
          },
          "orgUnit" : {
            "type" : "object",
            "properties" : {
              "id" : {
                "type" : "integer",
                "format" : "int64"
              },
              "type" : {
                "type" : "string",
                "enum" : [ "SITE" ]
              },
              "name" : {
                "type" : "string"
              }
            }
          },
          "status" : {
            "type" : "string",
            "enum" : [ "COMPLETED" ],
            "description" : "Fixed to COMPLETED for this exercise; SLA-status and breach-flag fields are out of scope for the POC and will be spec'd separately."
          },
          "workOrderType" : {
            "type" : "string",
            "example" : "Corrective Maintenance"
          },
          "description" : {
            "type" : "string"
          },
          "completedDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "resourceId" : {
            "type" : "integer",
            "format" : "int64",
            "nullable" : true,
            "description" : "Technician/resource who closed the work order, if assigned."
          }
        }
      },
      "StockOnHand" : {
        "type" : "object",
        "properties" : {
          "store" : {
            "type" : "object",
            "properties" : {
              "id" : {
                "type" : "integer",
                "format" : "int64"
              },
              "name" : {
                "type" : "string",
                "example" : "Main Store - Bellville"
              }
            }
          },
          "materialId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "materialCode" : {
            "type" : "string",
            "example" : "MAT-00231"
          },
          "materialDescription" : {
            "type" : "string",
            "example" : "Coupling, 25mm PVC"
          },
          "quantityOnHand" : {
            "type" : "number",
            "format" : "double"
          },
          "unitOfMeasure" : {
            "type" : "string",
            "example" : "EA"
          },
          "asOfTimestamp" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "When this on-hand snapshot was taken."
          }
        }
      },
      "StockMovement" : {
        "type" : "object",
        "properties" : {
          "movementId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "store" : {
            "type" : "object",
            "properties" : {
              "id" : {
                "type" : "integer",
                "format" : "int64"
              },
              "name" : {
                "type" : "string"
              }
            }
          },
          "materialId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "materialCode" : {
            "type" : "string"
          },
          "materialDescription" : {
            "type" : "string"
          },
          "transactionType" : {
            "type" : "string",
            "enum" : [ "RECEIPT", "ISSUE", "TRANSFER_IN", "TRANSFER_OUT", "ADJUSTMENT" ]
          },
          "quantity" : {
            "type" : "number",
            "format" : "double",
            "description" : "Signed where relevant (e.g. negative for ISSUE)."
          },
          "transactionTimestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "referenceDocument" : {
            "type" : "string",
            "nullable" : true,
            "description" : "Linked work order code or purchase-order/GRN number, where applicable."
          }
        }
      }
    },
    "parameters" : {
      "Page" : {
        "name" : "page",
        "in" : "query",
        "required" : false,
        "description" : "1-indexed page number. Defaults to the first page.",
        "schema" : {
          "type" : "integer",
          "minimum" : 1,
          "default" : 1
        }
      },
      "PerPage" : {
        "name" : "per_page",
        "in" : "query",
        "required" : false,
        "description" : "Items per page. Default 50, max 500.",
        "schema" : {
          "type" : "integer",
          "minimum" : 1,
          "maximum" : 500,
          "default" : 50
        }
      }
    },
    "headers" : {
      "RequestIdHeader" : {
        "description" : "Server-generated request id, echoed from `meta.request_id`.",
        "schema" : {
          "type" : "string",
          "pattern" : "^req_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "example" : "req_01K5H8N2Q3ZC1WQ8R6M0T4X9YB"
      }
    },
    "responses" : {
      "Unauthorized" : {
        "description" : "Missing or invalid API key.",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ApiEnvelopeBase"
            },
            "example" : {
              "success" : false,
              "data" : null,
              "message" : "Invalid or missing API key.",
              "error" : {
                "code" : "UNAUTHORIZED",
                "message" : "Invalid or missing API key."
              },
              "pagination" : null,
              "meta" : {
                "request_id" : "req_01K5H8N2Q3ZC1WQ8R6M0T4X9YB",
                "version" : "1",
                "timestamp" : "2026-09-10T09:00:00Z"
              }
            }
          }
        }
      },
      "Forbidden" : {
        "description" : "API key is valid but not scoped to the requested site/store.",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ApiEnvelopeBase"
            },
            "example" : {
              "success" : false,
              "data" : null,
              "message" : "API key is not scoped to this site.",
              "error" : {
                "code" : "FORBIDDEN",
                "message" : "API key is not scoped to this site."
              },
              "pagination" : null,
              "meta" : {
                "request_id" : "req_01K5H8N2Q3ZC1WQ8R6M0T4X9YB",
